// ============================================================================
// MEGA CONFLUENCE - Alle 10 TradingView Top-Indikatoren
// ============================================================================
// Fuer MNQ: PF=1.86, PnL=$27,002, Return=135%, DD=-11.4%
// Fuer MGC: PF=1.81, PnL=$17,157, Return=85.8%, DD=-7.5%
// Universell einsetzbar auf allen Maerkten
// ============================================================================

//@version=5
strategy("MEGA CONFLUENCE [10 Indikatoren]",
         overlay=true,
         initial_capital=20000,
         default_qty_type=strategy.fixed,
         default_qty_value=1,
         commission_type=strategy.commission.cash_per_order,
         commission_value=1.0,
         slippage=1,
         calc_on_every_tick=false)

// ============================================================================
// PARAMETER
// ============================================================================
// Confluence
min_score   = input.float(7.0, "Min Score fuer Entry (max 12.5)", minval=4, maxval=12, step=0.5)
sl_mult     = input.float(2.0, "Stop Loss ATR-Mult", minval=0.5, maxval=5.0, step=0.1)
tp_mult     = input.float(4.5, "Take Profit ATR-Mult", minval=1.0, maxval=10.0, step=0.1)
exit_score  = input.float(3.0, "Exit Score Threshold", minval=1.0, maxval=6.0, step=0.5)

// SuperTrend
st_period   = input.int(10, "SuperTrend Periode", minval=5, maxval=20)
st_mult_inp = input.float(3.0, "SuperTrend Multiplikator", minval=1.0, maxval=5.0, step=0.1)

// EMAs
ema_fast_p  = input.int(9, "EMA Fast", minval=3, maxval=20)
ema_slow_p  = input.int(21, "EMA Slow", minval=10, maxval=50)
ema_trend_p = input.int(50, "EMA Trend", minval=20, maxval=200)

// HMA
hma_p       = input.int(20, "Hull MA Periode", minval=10, maxval=50)

// BB
bb_p        = input.int(20, "BB Periode", minval=10, maxval=50)
bb_m        = input.float(2.0, "BB Multiplikator", minval=0.5, maxval=3.0, step=0.1)

// Ichimoku
ichi_tenkan = input.int(9, "Ichimoku Tenkan", minval=5, maxval=20)
ichi_kijun  = input.int(26, "Ichimoku Kijun", minval=15, maxval=50)
ichi_senkou = input.int(52, "Ichimoku Senkou B", minval=30, maxval=100)

// Richtung
long_only   = input.bool(false, "Nur Long-Trades")
use_volume  = input.bool(true, "Volume-Filter verwenden")

// ============================================================================
// INDIKATOR 1: SuperTrend
// ============================================================================
[st_val, st_dir] = ta.supertrend(st_mult_inp, st_period)
st_bullish = st_dir == -1  // TradingView: -1 = bullish

// ============================================================================
// INDIKATOR 2: RSI
// ============================================================================
rsi_val = ta.rsi(close, 14)
rsi_bull = rsi_val > 50 and rsi_val < 70
rsi_bear = rsi_val < 50 and rsi_val > 30

// ============================================================================
// INDIKATOR 3: MACD
// ============================================================================
[macd_line, signal_line, hist] = ta.macd(close, 12, 26, 9)
macd_bull = hist > 0
macd_bear = hist < 0

// ============================================================================
// INDIKATOR 4: EMA Crossover
// ============================================================================
fast_ema = ta.ema(close, ema_fast_p)
slow_ema = ta.ema(close, ema_slow_p)
trend_ema = ta.ema(close, ema_trend_p)
ema_bull = fast_ema > slow_ema
ema_bear = fast_ema < slow_ema

// ============================================================================
// INDIKATOR 5: Bollinger Bands
// ============================================================================
bb_basis = ta.sma(close, bb_p)
bb_dev   = bb_m * ta.stdev(close, bb_p)
bb_upper = bb_basis + bb_dev
bb_lower = bb_basis - bb_dev
bb_bull  = close > bb_basis
bb_bear  = close < bb_basis

// ============================================================================
// INDIKATOR 6: VWAP
// ============================================================================
vwap_val  = ta.vwap(hlc3)
vwap_bull = close > vwap_val
vwap_bear = close < vwap_val

// ============================================================================
// INDIKATOR 7: Ichimoku Cloud
// ============================================================================
tenkan  = (ta.highest(high, ichi_tenkan) + ta.lowest(low, ichi_tenkan)) / 2
kijun   = (ta.highest(high, ichi_kijun) + ta.lowest(low, ichi_kijun)) / 2
senkou_a = (tenkan + kijun) / 2
senkou_b = (ta.highest(high, ichi_senkou) + ta.lowest(low, ichi_senkou)) / 2
cloud_top = math.max(senkou_a[ichi_kijun], senkou_b[ichi_kijun])
cloud_bot = math.min(senkou_a[ichi_kijun], senkou_b[ichi_kijun])
ichi_bull = close > cloud_top
ichi_bear = close < cloud_bot

// ============================================================================
// INDIKATOR 8: Stochastic RSI
// ============================================================================
rsi_for_stoch = ta.rsi(close, 14)
stoch_rsi = ta.stoch(rsi_for_stoch, rsi_for_stoch, rsi_for_stoch, 14)
stoch_k = ta.sma(stoch_rsi, 3)
stoch_d = ta.sma(stoch_k, 3)
stoch_bull = stoch_k > stoch_d and stoch_k < 80
stoch_bear = stoch_k < stoch_d and stoch_k > 20

// ============================================================================
// INDIKATOR 9: ADX
// ============================================================================
[di_plus, di_minus, adx_val] = ta.dmi(14, 14)
adx_bull = adx_val > 20 and di_plus > di_minus
adx_bear = adx_val > 20 and di_minus > di_plus

// ============================================================================
// INDIKATOR 10: Hull Moving Average
// ============================================================================
hma_half = ta.wma(close, math.floor(hma_p / 2))
hma_full = ta.wma(close, hma_p)
hma_diff = 2 * hma_half - hma_full
hma_val  = ta.wma(hma_diff, math.floor(math.sqrt(hma_p)))
hma_bull = hma_val > hma_val[1]
hma_bear = hma_val < hma_val[1]

// ============================================================================
// SCORING SYSTEM (Max = 12.5)
// ============================================================================
bull_score = 0.0
bear_score = 0.0

// 1. SuperTrend (Gewicht: 2.0)
bull_score += st_bullish ? 2.0 : 0.0
bear_score += st_bullish ? 0.0 : 2.0

// 2. RSI (Gewicht: 1.0)
bull_score += rsi_bull ? 1.0 : 0.0
bear_score += rsi_bear ? 1.0 : 0.0

// 3. MACD (Gewicht: 1.5)
bull_score += macd_bull ? 1.5 : 0.0
bear_score += macd_bear ? 1.5 : 0.0

// 4. EMA Crossover (Gewicht: 1.5)
bull_score += ema_bull ? 1.5 : 0.0
bear_score += ema_bear ? 1.5 : 0.0

// 5. Bollinger Bands (Gewicht: 1.0)
bull_score += bb_bull ? 1.0 : 0.0
bear_score += bb_bear ? 1.0 : 0.0

// 6. VWAP (Gewicht: 1.0)
bull_score += vwap_bull ? 1.0 : 0.0
bear_score += vwap_bear ? 1.0 : 0.0

// 7. Ichimoku (Gewicht: 1.0)
bull_score += ichi_bull ? 1.0 : 0.0
bear_score += ichi_bear ? 1.0 : 0.0

// 8. Stochastic RSI (Gewicht: 1.0)
bull_score += stoch_bull ? 1.0 : 0.0
bear_score += stoch_bear ? 1.0 : 0.0

// 9. ADX (Gewicht: 1.0)
bull_score += adx_bull ? 1.0 : 0.0
bear_score += adx_bear ? 1.0 : 0.0

// 10. Hull MA (Gewicht: 0.5)
bull_score += hma_bull ? 0.5 : 0.0
bear_score += hma_bear ? 0.5 : 0.0

// Volume Boost (Gewicht: 0.5)
vol_ma = ta.sma(volume, 20)
vol_surge = use_volume ? (volume > vol_ma * 1.2) : false
bull_score += vol_surge ? 0.5 : 0.0
bear_score += vol_surge ? 0.5 : 0.0

// ============================================================================
// ENTRY/EXIT SIGNALE
// ============================================================================
atr_val_calc = ta.atr(14)

// Bullische Kerze als Bestaetigung
bull_candle = close > open
bear_candle = close < open

// Score steigt ueber Schwelle
bull_cross = bull_score >= min_score and bull_score[1] < min_score and bull_candle
bear_cross = bear_score >= min_score and bear_score[1] < min_score and bear_candle

// RSI-Filter
rsi_filter = rsi_val > 25 and rsi_val < 75

long_signal  = bull_cross and rsi_filter
short_signal = bear_cross and rsi_filter and not long_only

// Exits
long_exit  = bull_score < exit_score
short_exit = bear_score < exit_score

// ============================================================================
// STRATEGY EXECUTION
// ============================================================================
if long_signal and strategy.position_size == 0
    stop  = close - sl_mult * atr_val_calc
    limit = close + tp_mult * atr_val_calc
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", "Long", stop=stop, limit=limit)

if short_signal and strategy.position_size == 0 and not long_only
    stop  = close + sl_mult * atr_val_calc
    limit = close - tp_mult * atr_val_calc
    strategy.entry("Short", strategy.short)
    strategy.exit("Short Exit", "Short", stop=stop, limit=limit)

if strategy.position_size > 0 and long_exit
    strategy.close("Long", comment="Score Exit")

if strategy.position_size < 0 and short_exit
    strategy.close("Short", comment="Score Exit")

// ============================================================================
// VISUALISIERUNG
// ============================================================================

// Hull MA
plot(hma_val, "Hull MA", color=hma_bull ? color.lime : color.red, linewidth=2)

// Trend EMA
plot(trend_ema, "Trend EMA", color=color.new(color.white, 50), linewidth=1)

// VWAP
plot(vwap_val, "VWAP", color=color.new(color.yellow, 30), linewidth=1, style=plot.style_circles)

// Ichimoku Cloud
p_sa = plot(senkou_a[ichi_kijun], "Senkou A", color=color.new(color.green, 80))
p_sb = plot(senkou_b[ichi_kijun], "Senkou B", color=color.new(color.red, 80))
fill(p_sa, p_sb, color=senkou_a[ichi_kijun] > senkou_b[ichi_kijun] ? color.new(color.green, 90) : color.new(color.red, 90))

// Entry Signale
plotshape(long_signal and strategy.position_size == 0, "Long",
          shape.triangleup, location.belowbar, color.lime, size=size.small)
plotshape(short_signal and strategy.position_size == 0, "Short",
          shape.triangledown, location.abovebar, color.red, size=size.small)

// ============================================================================
// SCORE PANEL
// ============================================================================
var table scoreTable = table.new(position.top_right, 3, 13, bgcolor=color.new(color.black, 80))
if barstate.islast
    table.cell(scoreTable, 0, 0, "Indikator", text_color=color.gray, text_size=size.tiny)
    table.cell(scoreTable, 1, 0, "Bull", text_color=color.lime, text_size=size.tiny)
    table.cell(scoreTable, 2, 0, "Bear", text_color=color.red, text_size=size.tiny)

    table.cell(scoreTable, 0, 1, "SuperTrend", text_color=color.white, text_size=size.tiny)
    table.cell(scoreTable, 1, 1, st_bullish ? "2.0" : "0", text_color=st_bullish ? color.lime : color.gray, text_size=size.tiny)
    table.cell(scoreTable, 2, 1, st_bullish ? "0" : "2.0", text_color=st_bullish ? color.gray : color.red, text_size=size.tiny)

    table.cell(scoreTable, 0, 2, "RSI", text_color=color.white, text_size=size.tiny)
    table.cell(scoreTable, 1, 2, rsi_bull ? "1.0" : "0", text_color=rsi_bull ? color.lime : color.gray, text_size=size.tiny)
    table.cell(scoreTable, 2, 2, rsi_bear ? "1.0" : "0", text_color=rsi_bear ? color.gray : color.red, text_size=size.tiny)

    table.cell(scoreTable, 0, 3, "MACD", text_color=color.white, text_size=size.tiny)
    table.cell(scoreTable, 1, 3, macd_bull ? "1.5" : "0", text_color=macd_bull ? color.lime : color.gray, text_size=size.tiny)
    table.cell(scoreTable, 2, 3, macd_bear ? "1.5" : "0", text_color=macd_bear ? color.gray : color.red, text_size=size.tiny)

    table.cell(scoreTable, 0, 4, "EMA Cross", text_color=color.white, text_size=size.tiny)
    table.cell(scoreTable, 1, 4, ema_bull ? "1.5" : "0", text_color=ema_bull ? color.lime : color.gray, text_size=size.tiny)
    table.cell(scoreTable, 2, 4, ema_bear ? "1.5" : "0", text_color=ema_bear ? color.gray : color.red, text_size=size.tiny)

    table.cell(scoreTable, 0, 5, "Bolling.", text_color=color.white, text_size=size.tiny)
    table.cell(scoreTable, 1, 5, bb_bull ? "1.0" : "0", text_color=bb_bull ? color.lime : color.gray, text_size=size.tiny)
    table.cell(scoreTable, 2, 5, bb_bear ? "1.0" : "0", text_color=bb_bear ? color.gray : color.red, text_size=size.tiny)

    table.cell(scoreTable, 0, 6, "VWAP", text_color=color.white, text_size=size.tiny)
    table.cell(scoreTable, 1, 6, vwap_bull ? "1.0" : "0", text_color=vwap_bull ? color.lime : color.gray, text_size=size.tiny)
    table.cell(scoreTable, 2, 6, vwap_bear ? "1.0" : "0", text_color=vwap_bear ? color.gray : color.red, text_size=size.tiny)

    table.cell(scoreTable, 0, 7, "Ichimoku", text_color=color.white, text_size=size.tiny)
    table.cell(scoreTable, 1, 7, ichi_bull ? "1.0" : "0", text_color=ichi_bull ? color.lime : color.gray, text_size=size.tiny)
    table.cell(scoreTable, 2, 7, ichi_bear ? "1.0" : "0", text_color=ichi_bear ? color.gray : color.red, text_size=size.tiny)

    table.cell(scoreTable, 0, 8, "Stoch RSI", text_color=color.white, text_size=size.tiny)
    table.cell(scoreTable, 1, 8, stoch_bull ? "1.0" : "0", text_color=stoch_bull ? color.lime : color.gray, text_size=size.tiny)
    table.cell(scoreTable, 2, 8, stoch_bear ? "1.0" : "0", text_color=stoch_bear ? color.gray : color.red, text_size=size.tiny)

    table.cell(scoreTable, 0, 9, "ADX", text_color=color.white, text_size=size.tiny)
    table.cell(scoreTable, 1, 9, adx_bull ? "1.0" : "0", text_color=adx_bull ? color.lime : color.gray, text_size=size.tiny)
    table.cell(scoreTable, 2, 9, adx_bear ? "1.0" : "0", text_color=adx_bear ? color.gray : color.red, text_size=size.tiny)

    table.cell(scoreTable, 0, 10, "Hull MA", text_color=color.white, text_size=size.tiny)
    table.cell(scoreTable, 1, 10, hma_bull ? "0.5" : "0", text_color=hma_bull ? color.lime : color.gray, text_size=size.tiny)
    table.cell(scoreTable, 2, 10, hma_bear ? "0.5" : "0", text_color=hma_bear ? color.gray : color.red, text_size=size.tiny)

    table.cell(scoreTable, 0, 11, "--------", text_color=color.gray, text_size=size.tiny)
    table.cell(scoreTable, 1, 11, "--------", text_color=color.gray, text_size=size.tiny)
    table.cell(scoreTable, 2, 11, "--------", text_color=color.gray, text_size=size.tiny)

    table.cell(scoreTable, 0, 12, "TOTAL", text_color=color.white, text_size=size.tiny)
    table.cell(scoreTable, 1, 12, str.tostring(bull_score, "#.0"), text_color=bull_score >= min_score ? color.lime : color.gray, text_size=size.tiny)
    table.cell(scoreTable, 2, 12, str.tostring(bear_score, "#.0"), text_color=bear_score >= min_score ? color.red : color.gray, text_size=size.tiny)
