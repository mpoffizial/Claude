# Polymarket Authentication
POLY_PRIVATE_KEY=0x...          # Ethereum wallet private key (Polygon)
POLY_API_KEY=...                 # Polymarket L2 API Key
POLY_API_SECRET=...              # Polymarket L2 API Secret
POLY_API_PASSPHRASE=...          # Polymarket L2 Passphrase
POLY_PROXY_WALLET=0x...          # Proxy wallet address

# Optional
BINANCE_WS_URL=wss://stream.binance.com:9443
