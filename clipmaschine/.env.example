# Kopieren nach .env (im Projektordner) und ausfüllen. Die .env wird von git ignoriert.

# Twitch (optional) – ohne werden Top-Clips über die öffentliche Clip-Seite gefunden.
# Pflicht nur für den Live-Modus: https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# TikTok – https://developers.tiktok.com (App mit Login Kit + Content Posting API)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# YouTube – OAuth-Client (Typ "Desktop-App") als JSON aus der Google Cloud Console
YOUTUBE_CLIENT_SECRETS_FILE=client_secret.json

# Instagram – Business/Creator-Account, langlebiger Access Token
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# Optional: KI-Titel mit Claude – https://console.anthropic.com
ANTHROPIC_API_KEY=
